{
  "name": "sinta-scraper",
  "version": "1.1.0",
  "main": "scraper.js",
  "scripts": {
    "start": "node scraper.js",
    "scrape": "node scraper.js",
    "dev": "node scraper.js",
    "parse:html": "node extract-html.js",
    "analyze": "node analyze.js",
    "export:borang-penelitian": "node export-borang.js --jenis penelitian --input fixtures/sample-researches.json --authors fixtures/sample-authors.json",
    "export:borang-pengabdian": "node export-borang.js --jenis pengabdian --input fixtures/sample-researches.json --authors fixtures/sample-authors.json --out exports/borang-pengabdian",
    "export:report": "node export-report.js both",
    "export:report-html": "node export-report.js html",
    "export:report-pdf": "node export-report.js pdf",
    "test": "node --test tests/groundtruth.test.js tests/pagination.test.js"
  },
  "keywords": [
    "sinta",
    "scraper",
    "pagination",
    "kemdiktisaintek",
    "uwg"
  ],
  "author": "",
  "license": "ISC",
  "description": "Full-featured SINTA Kemdiktisaintek scraper with complete page extraction and multi-page pagination support",
  "dependencies": {
    "cheerio": "^1.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^18.0.6",
    "exceljs": "^4.4.0",
    "puppeteer": "^24.43.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}

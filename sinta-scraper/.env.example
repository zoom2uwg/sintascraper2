# Kredensial SINTA (kosongkan jika menggunakan --manual-login atau mode publik)
SINTA_USERNAME=
SINTA_PASSWORD=

# Mode Browser (false = headful agar login/verifikasi mudah dimonitor)
HEADLESS=false

# Basis URL SINTA
SINTA_BASE=https://sinta.kemdiktisaintek.go.id

# Target Afiliasi & Departemen
AFFILIATION_ID=2058
AFFILIATION_CODE=071030
AFFILIASI_NAMA=Universitas Widya Gama
DEPT_PARENT_KEY=420D8E73-68F0-4044-86CF-5138D1419B20

# Views default yang di-scrape (otomatis dilengkapi tab dinamis pada halaman)
VIEWS=scopus,wos,garuda,googlescholar,rama,researches,services,iprs,books,pak,kepakaran,matrics

# Pengaturan Kecepatan, Retry & Pagination
NAV_DELAY_MS=2500
PAGE_TIMEOUT_MS=60000
MAX_RETRIES=3
MAX_PAGES_PER_VIEW=0
SAVE_RAW_HTML=false

# Direktori Penyimpanan Data & Ekspor
OUTPUT_DIR=./data
